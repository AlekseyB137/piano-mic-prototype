{
  "name": "piano-mic-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test:synth": "npx --yes tsx test/synth-bench.ts",
    "test:song": "npx --yes tsx test/song-player.ts",
    "test:convert": "tools/.venv/bin/python tools/test_musicxml2json.py",
    "test:import": "npx --yes tsx test/import-musicxml.ts",
    "test": "npm run test:song && npm run test:import && npm run test:sync && npm run test:rec && npm run test:synth && npm run test:convert",
    "test:sync": "npx --yes tsx test/user-data.ts",
    "test:rec": "npx --yes tsx test/recording.ts",
    "replay": "npx --yes tsx tools/replay.ts"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@xmldom/xmldom": "^0.8.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
